generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArtifactType {
  NOTE
  LINK
  FILE
  TASK
  CALENDAR
  EMAIL
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum DocumentType {
  RESUME
  CERTIFICATE
  NOTE
  PDF
  DOCX
  OTHER
}

enum DocumentStatus {
  UPLOADED
  INGESTING
  READY
  FAILED
}

enum IngestionStatus {
  PENDING
  EXTRACTING
  CHUNKING
  EMBEDDING
  COMPLETED
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  PAUSED
}

enum NotificationChannel {
  EMAIL
  WEB_PUSH
  MOBILE_PUSH
}

model UserProfile {
  id                    String                   @id @default(cuid())
  authId                String                   @unique
  email                 String?                  @unique
  name                  String?
  avatarUrl             String?
  age                   Int?
  education             String?
  college               String?
  degree                String?
  skillsJson            String                   @default("[]")
  interestsJson         String                   @default("[]")
  careerGoalsJson       String                   @default("[]")
  resumeFileId          String?
  linkedinUrl           String?
  githubUrl             String?
  profileCompletion     Int                      @default(0)
  careerReadiness       Int                      @default(0)
  xpPoints              Int                      @default(0)
  currentStreak         Int                      @default(0)
  longestStreak         Int                      @default(0)
  lastActivityDate      DateTime?
  themePreference       String                   @default("pastel")
  studyGoalMin          Int                      @default(120)
  focusSessionMin       Int                      @default(25)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  projects              Project[]
  artifacts             Artifact[]
  events                PlannerEvent[]
  stickyNotes           StickyNote[]
  whiteboards           Whiteboard[]
  videoBookmarks        VideoBookmark[]
  fileItems             FileItem[]
  focusSessions         FocusSession[]
  educationHistory      EducationHistory[]
  skills                UserSkill[]
  careerGoals           UserGoal[]
  documentFolders       DocumentFolder[]
  documents             Document[]
  documentChunks        DocumentChunk[]
  embeddings            Embedding[]
  conversations         Conversation[]
  careerRoadmaps        CareerRoadmap[]
  userAchievements      UserAchievement[]
  notificationPreference NotificationPreference?
  notificationReminders NotificationReminder[]
  ingestionJobs         DocumentIngestionJob[]
  relaxMoodEntries      RelaxMoodEntry[]
}

model EducationHistory {
  id          String      @id @default(cuid())
  userId      String
  institution String
  degree      String?
  field       String?
  startYear   Int?
  endYear     Int?
  grade       String?
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startYear])
}

model UserSkill {
  id          String      @id @default(cuid())
  userId      String
  name        String
  category    String?
  level       Int         @default(1)
  targetLevel Int?
  evidence    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, category])
}

model Project {
  id        String      @id @default(cuid())
  userId    String
  title     String
  summary   String?
  color     String      @default("#22d3ee")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  artifacts Artifact[]

  @@index([userId, createdAt])
}

model Artifact {
  id         String       @id @default(cuid())
  userId     String
  projectId  String?
  title      String
  content    String
  type       ArtifactType
  source     String?
  contextKey String?
  dueAt      DateTime?
  occurredAt DateTime?
  isDone     Boolean      @default(false)
  status     TaskStatus   @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  project    Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user       UserProfile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
  @@index([projectId, createdAt])
}

model PlannerEvent {
  id          String      @id @default(cuid())
  userId      String
  title       String
  notes       String?
  startAt     DateTime
  endAt       DateTime?
  reminderAt  DateTime?
  isImportant Boolean     @default(false)
  isDone      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startAt])
}

model StickyNote {
  id        String      @id @default(cuid())
  userId    String
  content   String
  color     String      @default("#fef08a")
  isPinned  Boolean     @default(true)
  posX      Float       @default(0)
  posY      Float       @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Whiteboard {
  id        String      @id @default(cuid())
  userId    String
  title     String
  dataJson  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model VideoBookmark {
  id          String      @id @default(cuid())
  userId      String
  title       String
  url         String
  comment     String?
  tags        String?
  isCompleted Boolean     @default(false)
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model FileItem {
  id               String      @id @default(cuid())
  userId           String
  name             String
  pathOrUrl        String
  originalFileName String?
  mimeType         String?
  sizeBytes        Int?
  storageData      Bytes?
  category         String?
  subject          String?
  tags             String?
  lastPosition     String?
  progressNote     String?
  isCompleted      Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  user             UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model FocusSession {
  id             String      @id @default(cuid())
  userId         String
  durationMin    Int
  breakMin       Int
  screenLimitMin Int?
  blockedList    String?
  note           String?
  startedAt      DateTime
  endedAt        DateTime?
  createdAt      DateTime    @default(now())
  user           UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model DocumentFolder {
  id        String           @id @default(cuid())
  userId    String
  parentId  String?
  name      String
  color     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      UserProfile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    DocumentFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  DocumentFolder[] @relation("FolderTree")
  documents Document[]

  @@unique([userId, parentId, name])
  @@index([userId, name])
}

model Document {
  id              String                 @id @default(cuid())
  userId          String
  folderId        String?
  name            String
  originalName    String
  type            DocumentType
  status          DocumentStatus         @default(UPLOADED)
  mimeType        String
  sizeBytes       Int
  storageKey      String
  storageData     Bytes?
  extractedText   String?
  summary         String?
  tagsJson        String                 @default("[]")
  category        String?
  youtubeUrl      String?
  chatgptUrl      String?
  isFavorite      Boolean                @default(false)
  uploadedAt      DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  user            UserProfile            @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder          DocumentFolder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  chunks          DocumentChunk[]
  ingestionJobs   DocumentIngestionJob[]

  @@index([userId, type, uploadedAt])
  @@index([userId, category])
  @@index([folderId])
}

model DocumentChunk {
  id          String      @id @default(cuid())
  documentId  String
  userId      String
  chunkIndex  Int
  content     String
  tokenCount  Int?
  metadata    Json?
  createdAt   DateTime    @default(now())
  document    Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user        UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  embeddings  Embedding[]

  @@unique([documentId, chunkIndex])
  @@index([userId, documentId])
}

model Embedding {
  id          String         @id @default(cuid())
  userId      String
  chunkId     String?
  provider    String
  model       String
  dimensions  Int
  vector      Unsupported("vector(1536)")?
  vectorJson  Json?
  vectorHash  String?
  metadata    Json?
  createdAt   DateTime       @default(now())
  user        UserProfile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunk       DocumentChunk? @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([userId, provider, model])
  @@index([chunkId])
}

model DocumentIngestionJob {
  id          String          @id @default(cuid())
  userId      String
  documentId  String
  status      IngestionStatus @default(PENDING)
  provider    String?
  error        String?
  metadata     Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        UserProfile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document    Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
}

model Conversation {
  id        String      @id @default(cuid())
  userId    String
  title     String?
  scope     String      @default("career")
  metadata  Json?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  citations      Json?
  metadata       Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model CareerRoadmap {
  id          String      @id @default(cuid())
  userId      String
  targetRole  String
  title       String
  summary     String?
  planJson    Json
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals       UserGoal[]

  @@index([userId, targetRole])
}

model UserGoal {
  id          String         @id @default(cuid())
  userId      String
  roadmapId   String?
  title       String
  description String?
  category    String?
  status      GoalStatus     @default(NOT_STARTED)
  dueAt       DateTime?
  xpReward    Int            @default(10)
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        UserProfile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap     CareerRoadmap? @relation(fields: [roadmapId], references: [id], onDelete: SetNull)

  @@index([userId, status, dueAt])
}

model Achievement {
  id          String            @id @default(cuid())
  code        String            @unique
  name        String
  description String
  icon        String?
  xp          Int               @default(0)
  createdAt   DateTime          @default(now())
  users       UserAchievement[]
}

model UserAchievement {
  userId        String
  achievementId String
  earnedAt      DateTime    @default(now())
  user          UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
}

model NotificationPreference {
  id                    String                @id @default(cuid())
  userId                String                @unique
  channels              NotificationChannel[] @default([EMAIL])
  learningReminder      Boolean               @default(true)
  resumeUpdateReminder  Boolean               @default(true)
  certificationReminder Boolean               @default(true)
  interviewReminder     Boolean               @default(true)
  goalReminder          Boolean               @default(true)
  quietHoursStart       String?
  quietHoursEnd         String?
  timezone              String                @default("UTC")
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  user                  UserProfile           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationReminder {
  id          String                @id @default(cuid())
  userId      String
  title       String
  kind        String
  message     String?
  dueAt       DateTime
  channels    NotificationChannel[] @default([EMAIL])
  isSent      Boolean               @default(false)
  metadata    Json?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  user        UserProfile           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt])
  @@index([userId, kind, isSent])
}

model RelaxMoodEntry {
  id        String      @id @default(cuid())
  userId    String
  mood      String
  label     String
  emoji     String
  createdAt DateTime    @default(now())
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
